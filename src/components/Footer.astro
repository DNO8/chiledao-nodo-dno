---
import { site } from '../data';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '#blockchain', label: 'Blockchain' },
  { href: '#ia', label: 'IA' },
  { href: '#formacion', label: 'Formación' },
  { href: '#contacto', label: 'Contacto' },
];

const socialLabels = ['Linktree', 'Discord landing', 'WhatsApp group'];
const socialLinks = site.externalUrls.filter((link) => socialLabels.includes(link.label));
---

<footer class="bg-navy text-paper border-t border-paper/10">
  <div class="max-w-[var(--container-w)] mx-auto px-6 py-10 md:py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
      <div class="space-y-4">
        <h2 aria-label={site.orgName} class="font-heading text-3xl font-bold tracking-tight text-white-warm">
          <img src="/images/brand/chile-dao-light.svg" width="1000" height="606" alt={site.orgName} class="w-[150px] h-auto" loading="lazy" />
          <span class="sr-only">{site.orgName}</span>
        </h2>
        <p class="text-paper/80 max-w-sm">{site.tagline}</p>
      </div>

      <div class="space-y-4">
        <h3 class="font-heading text-lg font-semibold tracking-tight">Explora y aprende</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-paper/80 hover:text-white-warm focus:outline-none focus-visible:ring-2 focus-visible:ring-red rounded transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <button type="button" data-wave-toggle hidden aria-pressed="false"
          class="min-h-11 px-3 text-sm text-paper/80 hover:text-white-warm rounded focus-visible:outline-2 focus-visible:outline-red disabled:opacity-80">
          Pausar fondo animado
        </button>
      </div>

      <div class="space-y-4">
        <h3 class="font-heading text-lg font-semibold tracking-tight">Contacto</h3>
        <p>
          <a
            href={`mailto:${site.contactEmail}`}
            class="text-paper/80 hover:text-white-warm focus:outline-none focus-visible:ring-2 focus-visible:ring-red rounded transition-colors"
          >
            {site.contactEmail}
          </a>
        </p>
        {socialLinks.length > 0 && (
          <ul class="flex flex-wrap gap-3">
            {socialLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block px-3 py-1.5 text-sm font-medium bg-navy-soft text-paper/90 hover:bg-red hover:text-white-warm focus:outline-none focus-visible:ring-2 focus-visible:ring-red rounded transition-colors"
                >
                  {link.label.replace(' landing', '').replace(' participa', '').replace(' group', '')}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>

  <div class="border-t border-line/20">
    <div class="max-w-[var(--container-w)] mx-auto px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-paper/60">
      <p>{site.orgName}</p>
      <p>{currentYear}</p>
    </div>
  </div>
</footer>
