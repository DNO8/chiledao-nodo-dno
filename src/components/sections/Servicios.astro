---
import { servicios } from '../../data';
import FormationPolaroid from '../gallery/FormationPolaroid';
import { getImage } from 'astro:assets';
import workshop from '../../assets/images/trayectoria/block-camp-3.webp';
import conversation from '../../assets/images/galeria/polkadot-chiledao.jpg';
import community from '../../assets/images/galeria/polkadot-chiledao-2.jpg';
import speakers from '../../assets/images/galeria/polkadot-chiledao-4.jpg';
import foundations from '../../assets/images/galeria/polkadot-chiledao-5.jpg';
import practice from '../../assets/images/galeria/vendimiatech-workshop-chiledao.jpg';

const photos = [
  { src: workshop, alt: 'Participantes de un taller de Blockchain sosteniendo materiales impresos.', title: 'Blockchain en la práctica', caption: 'Explora cómo funciona Blockchain y dónde puede aplicarse.' },
  { src: conversation, alt: 'Expositor conversando con participantes sentados bajo un espacio techado.', title: 'Aprende en comunidad', caption: 'Comparte preguntas y conecta con otras personas interesadas en Web3.' },
  { src: community, alt: 'Expositor con micrófono junto a una pantalla sobre la comunidad Web3 de Chile.', title: 'Conecta con el ecosistema Web3', caption: 'Acércate a una comunidad donde aprender y explorar proyectos.' },
  { src: speakers, alt: 'Dos expositores conversando frente a participantes en un taller.', title: 'Preguntas que abren posibilidades', caption: 'Intercambia perspectivas para comprender las tecnologías descentralizadas.' },
  { src: foundations, alt: 'Expositor explicando fundamentos de Blockchain con apoyo de una pantalla.', title: 'Fundamentos para avanzar', caption: 'Comprende Blockchain antes de profundizar en protocolos y proyectos Web3.' },
  { src: practice, alt: 'Participantes con computadores frente a una presentación proyectada en una sala.', title: 'De las ideas a la práctica', caption: 'Explora el aprendizaje mediante experimentación y prototipos.' },
];
const sizes = '(min-width: 1160px) 520px, (min-width: 1024px) 46vw, calc(100vw - 68px)';
const slides = await Promise.all(photos.map(async (photo) => {
  const widths = [480, 800, 1200].filter(width => width <= photo.src.width);
  const variants = await Promise.all(widths.map(async width => {
    const [webp, avif] = await Promise.all([
      getImage({ src: photo.src, width, format: 'webp' }),
      getImage({ src: photo.src, width, format: 'avif' }),
    ]);
    return { width, webp: webp.src, avif: avif.src };
  }));
  const full = await getImage({ src: photo.src, width: photo.src.width, format: 'webp' });
  return { image: full.src, width: photo.src.width, height: photo.src.height, alt: photo.alt,
    title: photo.title, caption: photo.caption, sizes,
    webp: variants.map(value => `${value.webp} ${value.width}w`).join(', '),
    avif: variants.map(value => `${value.avif} ${value.width}w`).join(', ') };
}));
---

<section id="formacion" class="scroll-mt-24 bg-paper py-16 md:py-24" aria-labelledby="formacion-heading">
  <div class="max-w-[var(--container-w)] mx-auto px-6">
    <div class="mb-10 max-w-3xl">
      <p class="font-mono text-sm uppercase tracking-widest text-red mb-4">Formación</p>
      <h2 id="formacion-heading" class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-ink">
        Aprendizaje práctico para personas y equipos
      </h2>
      <p class="mt-5 text-lg text-ink/70 leading-relaxed">
        Encuentra el enfoque que necesitas: comprender los fundamentos, explorar proyectos Web3 o fortalecer los conocimientos de tu equipo.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 items-start gap-8 lg:gap-10">
      <FormationPolaroid client:load slides={slides} />
      <div class="grid gap-4">
        {servicios.map((servicio) => (
          <article class="bg-white-warm border border-line/20 rounded-xl p-5 md:p-6">
            <p class="font-mono text-xs uppercase tracking-widest text-ink/60 mb-2">{servicio.code}</p>
            <h3 class="font-heading text-xl font-semibold tracking-tight text-ink mb-2">{servicio.title}</h3>
            <p class="text-sm text-ink/70 leading-relaxed">{servicio.description}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4">
      <a href="#contacto" class="self-start inline-flex px-5 py-3 bg-navy text-white-warm font-semibold rounded-lg hover:bg-navy-soft focus:outline-none focus-visible:ring-2 focus-visible:ring-red transition-colors">
        Consultar disponibilidad
      </a>
      <p class="text-sm text-ink/70 max-w-xl">Consulta los temas, formatos y próximas actividades antes de planificar tu participación.</p>
    </div>
  </div>
</section>
