---
import { site } from '../../data';

const communityLink = site.externalUrls.find((link) => link.label === 'Linktree');
---

<section id="contacto" class="scroll-mt-24 bg-navy py-16 md:py-24" aria-labelledby="contacto-heading">
  <div class="max-w-[var(--container-w)] mx-auto px-6">
    <div class="max-w-3xl">
      <p class="font-mono text-sm uppercase tracking-widest text-red mb-4">Hablemos</p>
      <h2 id="contacto-heading" class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-white-warm mb-6">
        Da el siguiente paso en tu aprendizaje.
      </h2>
      <p class="text-lg md:text-xl text-paper/80 leading-relaxed mb-10">
        ¿Buscas un taller para ti o capacitación para tu equipo? Escribe a Chile DAO y cuéntanos qué tema te interesa, tu experiencia y a quién va dirigida la formación. Conversemos sobre el enfoque, los requisitos y la disponibilidad.
      </p>

      <a
        href={`mailto:${site.contactEmail}`}
        class="inline-flex max-w-full items-center px-5 py-3 bg-paper text-navy font-semibold hover:bg-white-warm focus:outline-none focus-visible:ring-2 focus-visible:ring-red rounded-lg transition-colors mb-4"
      >
        Consultar talleres y capacitación
      </a>

      <p class="text-paper/80 mb-8">{site.contactEmail} · También puedes consultar por aprendizaje en Inteligencia Artificial.</p>
      {communityLink && (
        <>
          <p class="text-paper/70 mb-4">También puedes conectar con la comunidad:</p>
          <div class="flex flex-wrap gap-3">
              <a
                href={communityLink.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-5 py-3 text-base font-medium bg-navy-soft text-paper hover:bg-red hover:text-white-warm focus:outline-none focus-visible:ring-2 focus-visible:ring-red rounded-lg transition-colors"
              >
                Conocer la comunidad
              </a>
          </div>
        </>
      )}
    </div>
  </div>
</section>
