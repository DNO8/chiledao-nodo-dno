---
import { site } from '../../data';
---

<section id="about" class="bg-paper py-20 md:py-32" aria-labelledby="about-heading">
  <div class="max-w-[var(--container-w)] mx-auto px-6">
    <div class="max-w-3xl">
      <p class="font-mono text-sm uppercase tracking-widest text-red mb-4">{site.legalStatus}</p>
      <h2 id="about-heading" class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-ink mb-6">
        {site.orgName} <span class="text-red">Nodo DNO</span>
      </h2>
      <p class="text-lg md:text-xl text-muted leading-relaxed mb-6">
        {site.tagline}
      </p>
      <p class="text-base md:text-lg text-ink/80 leading-relaxed">
        {site.statusDescription}
      </p>
    </div>
  </div>
</section>
