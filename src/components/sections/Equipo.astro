---
import { equipo } from '../../data';
---

<section id="equipo" class="bg-navy-soft py-20 md:py-32" aria-labelledby="equipo-heading">
  <div class="max-w-[var(--container-w)] mx-auto px-6">
    <div class="mb-12 md:mb-16">
      <p class="font-mono text-sm uppercase tracking-widest text-red mb-4">Quienes construimos</p>
      <h2 id="equipo-heading" class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-white-warm">
        Equipo
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      {equipo.map((miembro) => (
        <article class="bg-navy/50 border border-line/20 rounded-lg p-4 md:p-6">
          <p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">{miembro.conceptId}</p>
          <h3 class="font-heading text-lg md:text-xl font-semibold tracking-tight text-red mb-1">
            {miembro.conceptName}
          </h3>
          <p class="font-heading text-base font-medium text-white-warm mb-3">{miembro.fullName}</p>
          <p class="text-sm text-paper/70 leading-relaxed">{miembro.conceptDescription}</p>
        </article>
      ))}
    </div>
  </div>
</section>
