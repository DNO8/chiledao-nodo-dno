---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroScroll from '../components/hero/HeroScroll.astro';
import About from '../components/sections/About.astro';
import Pilares from '../components/sections/Pilares.astro';
import Objetivos from '../components/sections/Objetivos.astro';
import Desafios from '../components/sections/Desafios.astro';
import Servicios from '../components/sections/Servicios.astro';
import TrayectoriaHorizontal from '../components/trayectoria/TrayectoriaHorizontal.astro';
import Journey from '../components/journey/Journey.astro';
import Alianzas from '../components/sections/Alianzas.astro';
import Equipo from '../components/sections/Equipo.astro';
import GallerySphere from '../components/gallery/GallerySphere.astro';
import Testimonials from '../components/testimonials/Testimonials.astro';
import Faq from '../components/sections/Faq.astro';
import Contacto from '../components/sections/Contacto.astro';
---

<Layout title="ChileDAO Nodo DNO">
  <Header />
  <main id="main-content">
    <HeroScroll />
    <About />
    <Pilares />
    <Objetivos />
    <Desafios />
    <Servicios />
    <TrayectoriaHorizontal />
    <Journey />
    <Alianzas />
    <Equipo />
    <GallerySphere />
    <Testimonials />
    <Faq />
    <Contacto />
  </main>
  <Footer />
</Layout>
