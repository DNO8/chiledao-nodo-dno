---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroVideo from '../components/hero/HeroVideo.astro';
import About from '../components/sections/About.astro';
import Pilares from '../components/sections/Pilares.astro';
import Objetivos from '../components/sections/Objetivos.astro';
import Desafios from '../components/sections/Desafios.astro';
import Servicios from '../components/sections/Servicios.astro';
import Trayectoria from '../components/sections/Trayectoria.astro';
import Alianzas from '../components/sections/Alianzas.astro';
import Equipo from '../components/sections/Equipo.astro';
import Gallery from '../components/gallery/Gallery.astro';
import Testimonials from '../components/testimonials/Testimonials.astro';
import Faq from '../components/sections/Faq.astro';
import Contacto from '../components/sections/Contacto.astro';
---

<Layout title="ChileDAO Nodo DNO">
  <Header />
  <main id="main-content">
    <HeroVideo />
    <About />
    <Pilares />
    <Objetivos />
    <Desafios />
    <Servicios />
    <Trayectoria />
    <Alianzas />
    <Equipo />
    <Gallery />
    <Testimonials />
    <Faq />
    <Contacto />
  </main>
  <Footer />
</Layout>
