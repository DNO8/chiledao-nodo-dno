---
import '../styles/global.css';
import { site } from '../data';
import sora700 from '@fontsource/sora/files/sora-latin-700-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter500 from '@fontsource/inter/files/inter-latin-500-normal.woff2?url';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import geist400 from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';

// Reuse the current CSS faces, not a second font registration or public path.
const aboveFoldFonts = [sora700, inter400, inter500, inter600, geist400];

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.orgName,
  description = site.tagline,
} = Astro.props;
const ogTitle = title;
const ogDescription = description;
---

<!doctype html>
<html lang="es" style="scrollbar-gutter: stable;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    {aboveFoldFonts.map(href => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-paper focus:text-ink focus:px-4 focus:py-2 focus:rounded focus:outline-none focus:ring-2 focus:ring-red">
      Saltar al contenido principal
    </a>
    <slot />
  </body>
</html>
